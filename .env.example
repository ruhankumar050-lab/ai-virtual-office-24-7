# المنفذ والخادم
PORT=3000
HOST=0.0.0.0

# المزود الأساسي المجاني: builtin | groq | gemini | openrouter | ollama
AI_PROVIDER=builtin
AI_API_KEY=
AI_MODEL=

# المزود الاحتياطي التلقائي (Multi-AI + Auto-Failover)
AI_BACKUP_PROVIDER=none
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=

# Ollama (في حالة التشغيل المحلي)
OLLAMA_URL=http://127.0.0.1:11434

# الأمان والمصادقة (تُحفظ على الخادم فقط)
OWNER_PASSWORD=
SESSION_SECRET=

# تكامل Google Drive الرسمي (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# تكامل المنصة التعليمية
PLATFORM_API_KEY=

# المنفذ (المنصات السحابية مثل Render و Koyeb تضبطه تلقائياً)
PORT=3000

# المزود الأساسي المجاني: builtin | gemini | groq | openrouter | ollama
AI_PROVIDER=builtin
AI_API_KEY=
AI_MODEL=

# مزود احتياطي تلقائي عند امتلاء حد المزود الأساسي (اختياري)
AI_BACKUP_PROVIDER=none
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=

# في حالة استخدام Ollama محلياً
OLLAMA_URL=http://127.0.0.1:11434
